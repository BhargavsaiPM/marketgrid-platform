# ==============================================================================
# MarketGrid Commerce — Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and customize credentials before launching Docker.

# ------------------------------------------------------------------------------
# 1. MySQL Root & Per-Service Database Passwords
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_secure_password
USER_DB_USERNAME=user_service_user
USER_DB_PASSWORD=user_db_password_123

VENDOR_DB_USERNAME=vendor_service_user
VENDOR_DB_PASSWORD=vendor_db_password_123

PRODUCT_DB_USERNAME=product_service_user
PRODUCT_DB_PASSWORD=product_db_password_123

ORDER_DB_USERNAME=order_service_user
ORDER_DB_PASSWORD=order_db_password_123

# ------------------------------------------------------------------------------
# 2. JWT Signing Secret (Base64 encoded 256-bit secret key)
# ------------------------------------------------------------------------------
JWT_SECRET=bWFya2V0Z3JpZC1jb21tZXJjZS1zdXBlci1zZWNyZXQta2V5LWZvci1qd3QtdG9rZW4tMjAyNg==

# ------------------------------------------------------------------------------
# 3. Seeded Initial System Admin Password (Dev-only default)
# ------------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=Admin@12345

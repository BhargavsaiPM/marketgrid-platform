# ==============================================================================
# MarketGrid Commerce — .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Maven & Build Artifacts
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven release & properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# 2. Runtime Logs & Process IDs
# ------------------------------------------------------------------------------
logs/
**/logs/
pids/
**/pids/
*.log
*.pid
ping.log

# ------------------------------------------------------------------------------
# 3. Databases (H2 In-Memory / File Database)
# ------------------------------------------------------------------------------
*.db
*.mv.db
*.trace.db

# ------------------------------------------------------------------------------
# 4. IDEs & Editors
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
**/out/

# Visual Studio Code
.vscode/
*.code-workspace

# Eclipse / Spring Tool Suite (STS)
.classpath
.project
.settings/
.springBeans
bin/
**/bin/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/

# ------------------------------------------------------------------------------
# 5. Operating System Generated Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 6. Temporary & Scratch Files
# ------------------------------------------------------------------------------
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
